# Copy this file to .env.local and fill in values from your Supabase project.
# .env.local is ignored by Git. Never commit real credentials.

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. It is safe to expose in the browser because RLS is the
# security boundary. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin used for auth email redirects and callback redirects.
# Use http://localhost:3000 locally and your HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Required by /api/waitlist because anon/authenticated no longer
# have INSERT on public.waitlist. NEVER prefix this with NEXT_PUBLIC_, expose it
# to the browser, commit it, or log it.
# Local Supabase: run `npx supabase status` and copy the service_role key.
SUPABASE_SERVICE_ROLE_KEY=
