# Copy this file to .env.local and fill in values from your Supabase project.
# .env.local is ignored by Git. Never commit real credentials.

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. It is safe to expose in the browser because RLS is the
# security boundary. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin used for auth email redirects and callback redirects.
# Use http://localhost:3000 locally and your HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Required by /api/waitlist because anon/authenticated no longer
# have INSERT on public.waitlist. NEVER prefix this with NEXT_PUBLIC_, expose it
# to the browser, commit it, or log it.
# Local Supabase: run `npx supabase status` and copy the service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Phase 4B worker and scheduler (optional; disabled by default)
# ---------------------------------------------------------------------------
# These are process environment variables for `npm run worker:service` and
# `npm run worker:scheduler`; they are not NEXT_PUBLIC_ variables and must not
# be committed with real values. Use separate login roles granted exactly one
# of onedash_queue, onedash_ingestor, or onedash_scheduler. Never use the
# service-role key for a worker connection.
#
# disabled = heartbeat only. fixtures = operator-allowlisted .test monitors.
# customer is intentionally rejected in Phase 4B.
ONEDASH_WORKER_EXECUTION_MODE=disabled
ONEDASH_QUEUE_DATABASE_URL=
ONEDASH_INGESTOR_DATABASE_URL=
ONEDASH_SCHEDULER_DATABASE_URL=
ONEDASH_DB_SSL=false
ONEDASH_REGION=local-1
ONEDASH_SCHEDULER_REGION=global
ONEDASH_WORKER_ID=
ONEDASH_SCHEDULER_ID=
ONEDASH_WORKER_CONCURRENCY=2
ONEDASH_LEASE_SECONDS=120
ONEDASH_POLL_INTERVAL_MS=1000
ONEDASH_HEARTBEAT_INTERVAL_MS=5000
ONEDASH_REAP_INTERVAL_MS=5000
ONEDASH_SHUTDOWN_GRACE_MS=15000
ONEDASH_SCHEDULER_INTERVAL_MS=5000
ONEDASH_SCHEDULER_BATCH_SIZE=50
ONEDASH_SCHEDULER_JITTER_SECONDS=10
ONEDASH_FIXTURE_HOSTS=
ONEDASH_HEALTH_HOST=127.0.0.1
ONEDASH_HEALTH_PORT=9464
# Required when ONEDASH_HEALTH_HOST is not loopback. At least 16 characters.
ONEDASH_METRICS_TOKEN=
ONEDASH_LOG_LEVEL=info
