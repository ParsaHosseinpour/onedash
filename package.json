{
  "name": "onedash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:checker": "vitest run tests/checker",
    "test:scheduler": "vitest run tests/scheduler",
    "test:worker": "vitest run tests/worker tests/scheduler",
    "test:phase4b": "vitest run --config vitest.phase4b.config.mts",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db --local",
    "db:lint": "supabase db lint --local",
    "worker:build": "tsc -p worker/tsconfig.json",
    "worker:scheduler": "tsx worker/scheduler/main.ts",
    "worker:service": "tsx worker/service/main.ts",
    "worker:start:scheduler": "node dist-worker/scheduler/main.js",
    "worker:start:service": "node dist-worker/service/main.js"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ipaddr.js": "^2.5.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
